{
  "name": "mycloud",
  "version": "1.0.0",
  "private": true,
  "description": "MyCloud - a self-hosted personal cloud drive",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx scripts/init-system.ts",
    "setup:admin": "tsx scripts/bootstrap-admin.ts",
    "generate-secret": "tsx scripts/generate-secret.ts",
    "worker": "tsx scripts/worker.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "install-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "setup:tailscale": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-tailscale.ps1",
    "setup:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-firewall.ps1",
    "postinstall": "node -e \"try{require('sharp')}catch(e){console.warn('sharp is optional during install but required for image thumbnails')}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "file-type": "19.6.0",
    "lucide-react": "0.468.0",
    "mongoose": "8.24.7",
    "next": "14.2.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.33.5": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  }
}
