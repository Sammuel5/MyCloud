# ---------------------------------------------------------------------------
# MyCloud environment configuration
# Copy this file to .env.local and replace every placeholder.
# NEVER commit .env.local. Generate AUTH_SECRET with: npm run generate-secret
# ---------------------------------------------------------------------------

NODE_ENV=production

# Public origin used by the app. For Tailscale Serve use your private HTTPS URL.
# Example: https://mycloud.tailnet-name.ts.net
# AUTH_URL can be omitted when the request Host/forwarded headers are trusted.
AUTH_URL=https://mycloud.example-tailnet.ts.net
AUTH_TRUST_HOST=true
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Local MongoDB only. Do not expose port 27017 to the network.
MONGODB_URI=mongodb://127.0.0.1:27017/mycloud

# Dedicated local folder on your storage disk. Never point this at C:\.
MYCLOUD_STORAGE_PATH=D:\MyCloudStorage

# Upload and quota settings (bytes). 0 quota means unlimited (limited by disk).
MYCLOUD_MAX_UPLOAD_BYTES=21474836480
MYCLOUD_CHUNK_SIZE_BYTES=33554432
MYCLOUD_DEFAULT_QUOTA_BYTES=0
MYCLOUD_TEMP_UPLOAD_HOURS=24
MYCLOUD_SESSION_DAYS=7
MYCLOUD_TRASH_RETENTION_DAYS=30

# Optional comma-separated allowlist override. Dangerous executable/script
# extensions are always rejected even if listed here.
MYCLOUD_ALLOWED_EXTENSIONS=

# Default backup destination. Use an external drive or another machine.
# NEVER choose a folder inside MYCLOUD_STORAGE_PATH.
MYCLOUD_BACKUP_PATH=E:\MyCloudBackups

# Set to true only when running a separate worker service. When false/empty,
# the web process runs its own background worker.
MYCLOUD_DISABLE_WORKER=false

# Optional explicit paths. Leave blank to auto-detect bundled binaries.
MYCLOUD_FFMPEG_PATH=
MYCLOUD_FFPROBE_PATH=

# Application display name and log level (debug | info | warn | error)
MYCLOUD_APP_NAME=MyCloud
MYCLOUD_LOG_LEVEL=info

# Treat reverse-proxy forwarded headers as trusted only if a local reverse proxy
# (Tailscale Serve, Caddy, IIS ARR) terminates TLS on this machine.
MYCLOUD_TRUST_FORWARDED_HEADERS=true
